{
  "opencollection": "1.0.0",
  "info": {
    "name": "Pigment External ApplicationApi API",
    "version": "v1-external"
  },
  "request": {
    "auth": {
      "type": "bearer",
      "token": "{{bearerToken}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "ApplicationApi",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "GET /api/v1/applications",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "{{baseUrl}}/api/v1/applications"
          },
          "docs": "Retrieve all applications metadata"
        }
      ]
    }
  ],
  "bundled": true
}